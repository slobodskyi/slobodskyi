    {
      "id": "717e598b-cdb8-8d61-39cd-08cc92565c77",
      "type": "text",
      "text": {
        "html": "<h3 class=\"course-heading lesson\">Знаходити відповіді</h3>",
        "text": "Знаходити відповіді"

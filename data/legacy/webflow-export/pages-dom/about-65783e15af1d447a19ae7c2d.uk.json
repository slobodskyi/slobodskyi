      "html": "<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"ProfilePage\",\n      \"dateCreated\": \"2004-05-11T12:34:00-05:00\",\n      \"dateModified\": \"2025-01-01T14:53:00-05:00\",\n      \"mainEntity\": {\n        \"@type\": \"Person\",\n        \"name\": \"Олександр Слободський\",\n        \"alternateName\": \"slobodskyi\",\n        \"identifier\": \"01\",\n        \"description\": \"Більше десяти років я активно допомагаю авторам у сфері креативної економіки знаходити способи заробітку на їхніх інтересах.\",\n        \"interactionStatistic\": [{\n          \"@type\": \"InteractionCounter\",\n          \"interactionType\": \"https://schema.org/FollowAction\",\n          \"userInteractionCount\": 10117\n   }],\n         \"image\": \"https://cdn.prod.website-files.com/6558ae529e9653f7d61a6917/65e87c4e3477ba12b56b802c_oleksandr-slobodskyi.webp\",\n  \"sameAs\": [\n    \"https://www.youtube.com/@slobodskyi\",\n    \"https://www.patreon.com/slobodskyi\",\n    \"https://www.instagram.com/slobodskyi\",\n    \"https://x.com/slobodskyi\",\n    \"https://www.pinterest.com/slobodskyi\",\n    \"https://tiktok.com/@slobodskyi.com\"\n  ]  \n      }\n    }\n    </script>",

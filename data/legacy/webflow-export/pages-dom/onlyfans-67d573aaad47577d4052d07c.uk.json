    {
      "id": "d8bd20ec-9fa4-cead-d067-56b7ea83f9d2",
      "type": "html-embed",
      "html": "<iframe src=\"https://www.videoask.com/fyojrsapl\" allow=\"camera *; microphone *; autoplay *; encrypted-media *; fullscreen *; display-capture *;\" width=\"100%\" height=\"480px\" style=\"border: none; border-radius: 24px\"></iframe>",

    {
      "id": "d49dbbe7-1334-0774-cc95-c86d2d99e4b2",
      "type": "text",
      "text": {
        "html": "<div>You're in. Next email comes when I find something worth sharing.</div>",
        "text": "You're in. Next email comes when I find something worth sharing."
      },
      "attributes": {}
    },
    {
      "id": "d49dbbe7-1334-0774-cc95-c86d2d99e4b5",
      "type": "text",
      "text": {
        "html": "<div>Didn't go through. Try again — or just email me directly.</div>",
        "text": "Didn't go through. Try again — or just email me directly."
      },
      "attributes": {}
    },
    {
      "id": "06a9653a-2037-2d62-234d-8952aa6947db",
      "type": "text",
      "text": {
        "html": "<div id=\"start\" class=\"article-rich-text\"><h2 data-w-id=\"06a9653a-2037-2d62-234d-8952aa6947dc\">Where to Start?</h2><p data-w-id=\"06a9653a-2037-2d62-234d-8952aa6947de\">Start with the free guides below. They'll take you from idea to income, step by step.</p><p data-w-id=\"06a9653a-2037-2d62-234d-8952aa6947e0\">Need faster results? <a href=\"https://slobodskyi.com/courses/consultation\" data-w-id=\"06a9653a-2037-2d62-234d-8952aa6947e2\">Book a consultation</a> for a personalized roadmap.</p></div>",
        "text": null
      },
      "attributes": {}
    },

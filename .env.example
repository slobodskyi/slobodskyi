# Copy to .env (git-ignored; the pre-commit hook also blocks it) and fill in.
# Never paste tokens into chat, commits or issues.

# Webflow Data API v2 — site token, read-only scopes:
# Assets: Read, CMS: Read, Pages: Read, Sites: Read, Forms: Read.
# Webflow → Site settings → Apps & integrations → API access → Generate API token.
WEBFLOW_API_TOKEN=

# Webflow → Site settings → General → Overview → Site ID (24 hex characters).
WEBFLOW_SITE_ID=

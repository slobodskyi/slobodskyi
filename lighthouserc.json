{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 4173 --directory apps/site/dist",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/create.html",
        "http://localhost:4173/create/ai.html",
        "http://localhost:4173/create/ai/chatgpt.html",
        "http://localhost:4173/about.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}

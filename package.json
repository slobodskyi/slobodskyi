{
  "name": "slobodskyi-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "preview": "pnpm --filter site preview",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "content": "node --disable-warning=ExperimentalWarning packages/core/src/cli.ts",
    "legacy:crawl": "node --disable-warning=ExperimentalWarning scripts/legacy/crawl.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:preview": "pnpm --filter site deploy:preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}

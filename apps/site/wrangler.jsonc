{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slobodskyi-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about/ -> 301 /about, matching the legacy site.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only API routes hit the Worker; every page is served as a static file.
    "run_worker_first": ["/api/*"],
  },
  // Contact form (/api/contact): mail goes only to CONTACT_TO. Turnstile secret:
  //   wrangler secret put TURNSTILE_SECRET [--env preview]
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "oleksandr@slobodskyi.com" }],
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "slobodskyi-site-preview",
      // The preview must never be indexed: the Worker runs first on every request
      // and adds X-Robots-Tag: noindex.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true,
      },
      "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "oleksandr@slobodskyi.com" }],
      "vars": {
        "ENVIRONMENT": "preview",
        "CONTACT_TO": "oleksandr@slobodskyi.com",
        "CONTACT_FROM": "contact-form@slobodskyi.com",
      },
    },
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CONTACT_TO": "oleksandr@slobodskyi.com",
    "CONTACT_FROM": "contact-form@slobodskyi.com",
  },
}

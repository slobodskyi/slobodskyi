{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slobodskyi-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first for pages: it turns /about/ into a 301 like the legacy site (assets alone
    // answer 307) and serves the .md copy to `Accept: text/markdown` (see worker.ts). Hashed build
    // assets skip it.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*"],
  },
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "slobodskyi-site-preview",
      // Also served on v2.slobodskyi.com (Cloudflare creates the DNS record). Still noindex there.
      "routes": [{ "pattern": "v2.slobodskyi.com", "custom_domain": true }],
      "workers_dev": true,
      // The preview must never be indexed: the Worker runs first on every request
      // and adds X-Robots-Tag: noindex.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true,
      },
      "vars": { "ENVIRONMENT": "preview" },
    },
  },
  "vars": { "ENVIRONMENT": "production" },
}

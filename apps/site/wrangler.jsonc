{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slobodskyi-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Assets alone would answer /about/ with a 307; the Worker turns it into a 301 like the legacy
    // site (see worker.ts), so only API routes and paths ending in "/" hit the Worker.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/*/"],
  },
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "slobodskyi-site-preview",
      // The preview must never be indexed: the Worker runs first on every request
      // and adds X-Robots-Tag: noindex.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "drop-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true,
      },
      "vars": { "ENVIRONMENT": "preview" },
    },
  },
  "vars": { "ENVIRONMENT": "production" },
}

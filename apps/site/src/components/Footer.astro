  },
  {
    name: 'Threads',
    href: 'https://www.threads.com/@slobodskyi',
    path: 'M17.7 11.1l-.3-.2c-.2-3-1.8-4.6-4.6-4.7-1.6 0-3 .7-3.8 2l1.5 1c.6-.9 1.6-1.1 2.3-1.1 1 0 1.7.3 2.1.9.3.4.5 1 .6 1.7-.8-.1-1.6-.2-2.5-.1-2.6.1-4.2 1.6-4.1 3.7.1 1.1.6 2 1.5 2.6.8.5 1.7.7 2.8.7 1.4-.1 2.5-.6 3.2-1.6.6-.7.9-1.7 1-2.9.7.4 1.2.9 1.4 1.6.5 1.1.5 2.9-1 4.4-1.3 1.3-2.9 1.9-5.3 1.9-2.6 0-4.6-.9-5.9-2.5C5.4 16.9 4.8 14.8 4.8 12s.6-4.9 1.8-6.4c1.3-1.6 3.3-2.5 5.9-2.5 2.7 0 4.7.9 6 2.5.7.8 1.1 1.8 1.4 2.9l1.7-.5c-.4-1.4-1-2.6-1.8-3.6C18.2 2.3 15.8 1.2 12.6 1.2h-.1C9.4 1.2 7 2.3 5.4 4.3 4 6.1 3.2 8.7 3.2 12s.8 5.9 2.2 7.7c1.6 2 4 3.1 7.1 3.1h.1c2.8 0 4.7-.7 6.3-2.3 2.1-2.1 2-4.7 1.3-6.3-.5-1.2-1.4-2.1-2.5-2.8zm-4.9 4.6c-1.1.1-2.3-.4-2.3-1.5 0-.8.6-1.7 2.4-1.8h.6c.7 0 1.3.1 1.9.2-.2 2.7-1.5 3-2.6 3.1z',
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@slobodskyi',
    path: 'M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z',
  },

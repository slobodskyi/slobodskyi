---

{disclaimer && (
  <div class="container">
    <p class="disclaimer">
      {s.disclaimer} <a href={p('/affiliate-disclosure')}>{s.disclaimerLink}</a>
    </p>
  </div>
)}
<footer class="site-footer">
  <nav aria-label="Footer">
    <a href={p('/about')}>{s.about}</a>
    <a href={p('/contacts')}>{s.contacts}</a>
    <a href={p('/affiliate-disclosure')}>{s.affiliate}</a>
  </nav>
  <div class="socials">
    {socials.map((x) => (
      <a href={x.href} target="_blank" rel="noopener" aria-label={x.name}>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d={x.path} />
        </svg>
      </a>
    ))}
  </div>
</footer>

<style>
  .disclaimer {
    background: var(--soft-line);
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.45;
    margin: 40px 0 0;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1200px;
    margin: 40px auto 0;
    padding: 24px var(--gutter) 40px;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .site-footer a {
    color: var(--text);
    text-decoration: none;
    font-size: 17px;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .socials {
    display: flex;
    gap: 16px;
  }
</style>

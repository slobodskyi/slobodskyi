---
import { withLangPrefix, type Lang } from '@slobodskyi/core';
import { t } from '../lib/i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  lang: Lang;
  /** Affiliate note above the footer (articles, hubs, categories). */
  disclaimer?: boolean;
}
const { lang, disclaimer = false } = Astro.props;
const s = t(lang);
const p = (route: string) => withLangPrefix(lang, route);
const socials: { name: string; icon: IconName; href: string }[] = [
  {
    name: 'Instagram',
    icon: 'instagram',
    href: 'https://www.instagram.com/slobodskyi',
  },
  {
    name: 'Threads',
    icon: 'threads',
    href: 'https://www.threads.com/@slobodskyi',
  },
  {
    name: 'YouTube',
    icon: 'youtube',
    href: 'https://www.youtube.com/@slobodskyi',
  },
];
---

{disclaimer && (
  <div class="container">
    <p class="disclaimer">
      {s.disclaimer} <a href={p('/affiliate-disclosure')}>{s.disclaimerLink}</a>
    </p>
  </div>
)}
<footer class="site-footer">
  <nav aria-label="Footer">
    <a href={p('/about')}>{s.about}</a>
    <a href={p('/contacts')}>{s.contacts}</a>
    <a href={p('/affiliate-disclosure')}>{s.affiliate}</a>
  </nav>
  <div class="socials">
    {socials.map((x) => (
      <a href={x.href} target="_blank" rel="noopener" aria-label={x.name}>
        <Icon name={x.icon} />
      </a>
    ))}
  </div>
</footer>

<style>
  .disclaimer {
    background: var(--color-surface-alt);
    padding: 16px 20px;
    font-size: 15px;
    line-height: 1.45;
    margin: 40px 0 0;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1200px;
    margin: 40px auto 0;
    padding: 24px var(--gutter) 40px;
  }
  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .site-footer a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 17px;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .socials {
    display: flex;
    gap: 16px;
  }
</style>

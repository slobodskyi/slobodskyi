---
import { withLangPrefix, type Lang } from '@slobodskyi/core';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Affiliate note above the footer (articles, hubs, categories). */
  disclaimer?: boolean;
}
const { lang, disclaimer = false } = Astro.props;
const s = t(lang);
const p = (route: string) => withLangPrefix(lang, route);
const socials = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/slobodskyi',

---
import type { Heading } from '@slobodskyi/core';

interface Props {
  headings: Heading[];
  title: string;
}
// H2 only, like the legacy table of contents. Anchors come from core extractHeadings().
const headings = Astro.props.headings.filter((h) => h.depth === 2);
---

{headings.length > 1 && (
  <details class="toc" open>
    <summary>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="11" fill="#2a64f6" />
        <text
          x="12"
          y="17"
          text-anchor="middle"
          font-size="14"
          font-family="Arial"
          font-weight="700"
          fill="#fff"
        >
          ?
        </text>
      </svg>
      {Astro.props.title}
    </summary>
    <ol>
      {headings.map((h) => (
        <li>
          <a href={`#${h.anchor}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    margin: 20px 0 32px;
    font-size: 16px;
    line-height: 24px;
    background: var(--surface);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 15px;
    font-weight: 700;
    cursor: pointer;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    border-top: 1px solid var(--line);
  }
  .toc a {
    display: block;
    padding: 10px 15px;
    color: var(--text);
    text-decoration: none;
    background: var(--bg);
  }
  .toc a:hover {
    background: var(--purple);
  }
</style>

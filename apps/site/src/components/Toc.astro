---
import type { Heading } from '@slobodskyi/core';

interface Props {
  headings: Heading[];
  title: string;
  /** Side-rail copy (Article template, wide screens): quiet list that marks the section being read. */
  rail?: boolean;
}
// H2 only, like the legacy table of contents. Anchors come from core extractHeadings().
const headings = Astro.props.headings.filter((h) => h.depth === 2);
const { rail = false } = Astro.props;
---

{/* Default: a numbered index in the text flow. `rail`: the companion that follows the reader
    on wide screens; it stays out of the way while the index itself is on screen. */}
{headings.length > 1 && (
  <nav
    class:list={['toc', rail && 'toc-rail-nav']}
    aria-label={Astro.props.title}
    data-toc={rail ? 'rail' : 'index'}
  >
    <p class="toc-title">{Astro.props.title}</p>
    <ol>
      {headings.map((h) => (
        <li>
          <a href={`#${h.anchor}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  // Rail only: show it once the index has left the screen, and mark the section being read.
  // Without JS the rail is simply always visible.
  const index = document.querySelector<HTMLElement>('[data-toc="index"]');
  for (const rail of document.querySelectorAll<HTMLElement>('[data-toc="rail"]')) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let current = -1;
    let queued = false;
    const update = () => {
      queued = false;
      rail.toggleAttribute('data-visible', !index || index.getBoundingClientRect().bottom < 0);
      // The last heading that has passed under the sticky header.
      let active = -1;
      targets.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top <= 120) active = i;
      });
      if (active === current) return;
      links[current]?.removeAttribute('aria-current');
      links[active]?.setAttribute('aria-current', 'location');
      current = active;
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .toc {
    margin: 0 0 var(--space-6);
    font-size: var(--text-md);
    line-height: 1.4;
  }
  .toc-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .toc li {
    counter-increment: toc;
    break-inside: avoid;
    border-top: 1px solid var(--color-border-soft);
  }
  .toc a {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: calc(var(--text-md) * 1.4);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .toc a:hover {
    color: var(--color-accent);
  }
  /* Two columns, read top to bottom. The list's bottom rule would close only one column,
     so each item draws its own rule below and the list draws the top one. */
  @media (min-width: 40rem) {
    .toc ol {
      columns: 2;
      column-gap: var(--space-6);
      border-top: 1px solid var(--color-border-soft);
      border-bottom: 0;
    }
    .toc li {
      border-top: 0;
      border-bottom: 1px solid var(--color-border-soft);
    }
  }

  /* Side rail: exists only where the Article template has a margin to put it in. */
  .toc-rail-nav {
    display: none;
  }
  @media (min-width: 86rem) {
    .toc-rail-nav {
      display: block;
      font-size: var(--text-sm);
      transition:
        opacity var(--duration) var(--ease),
        visibility var(--duration) var(--ease);
    }
    .toc-rail-nav .toc-title {
      padding-left: var(--space-4);
    }
    .toc-rail-nav ol {
      columns: auto;
      border: 0;
      border-left: 1px solid var(--color-border-soft);
    }
    .toc-rail-nav li {
      border: 0;
    }
    .toc-rail-nav a {
      margin-left: -1px;
      padding: 6px var(--space-4);
      border-left: 2px solid transparent;
      color: var(--color-muted);
    }
    .toc-rail-nav a::before {
      content: none;
    }
    .toc-rail-nav a:hover {
      color: var(--color-text);
    }
    .toc-rail-nav a[aria-current] {
      border-left-color: var(--color-accent);
      color: var(--color-accent);
    }
  }
  /* With scripting the rail waits until the index has scrolled away (no flash on load). */
  @media (min-width: 86rem) and (scripting: enabled) {
    .toc-rail-nav:not([data-visible]) {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

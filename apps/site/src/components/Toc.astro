---
import type { Heading } from '@slobodskyi/core';
import Icon from './Icon.astro';

interface Props {
  headings: Heading[];
  title: string;
}
// H2 only, like the legacy table of contents. Anchors come from core extractHeadings().
const headings = Astro.props.headings.filter((h) => h.depth === 2);
---

{headings.length > 1 && (
  <details class="toc" open>
    <summary>
      <Icon name="list" size={20} class="toc-icon" />
      {Astro.props.title}
    </summary>
    <ol>
      {headings.map((h) => (
        <li>
          <a href={`#${h.anchor}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 20px 0 32px;
    font-size: 16px;
    line-height: 24px;
    background: var(--color-surface);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 15px;
    font-weight: 700;
    cursor: pointer;
  }
  .toc :global(.toc-icon) {
    color: var(--color-accent);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    border-top: 1px solid var(--color-border);
  }
  .toc a {
    display: block;
    padding: 10px 15px;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-bg);
  }
  .toc a:hover {
    background: var(--color-tint);
  }
</style>

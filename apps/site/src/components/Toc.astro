---
import type { Heading } from '@slobodskyi/core';
import Icon from './Icon.astro';

interface Props {
  headings: Heading[];
  title: string;
}
// H2 only, like the legacy table of contents. Anchors come from core extractHeadings().
const headings = Astro.props.headings.filter((h) => h.depth === 2);
---

{headings.length > 1 && (
  <details class="toc" open>
    <summary>
      <Icon name="list" size={20} class="toc-icon" />
      <span class="toc-title">{Astro.props.title}</span>
      <Icon name="chevron-down" size={18} class="toc-chevron" />
    </summary>
    <ol>
      {headings.map((h) => (
        <li>
          <a href={`#${h.anchor}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc {
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    margin: 0 0 var(--space-6);
    font-size: var(--text-md);
    line-height: 1.4;
    background: var(--color-surface);
  }
  .toc summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary:focus-visible {
    border-radius: var(--radius-md);
  }
  .toc-title {
    flex: 1;
  }
  .toc :global(.toc-icon) {
    color: var(--color-accent);
  }
  .toc :global(.toc-chevron) {
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease);
  }
  .toc[open] :global(.toc-chevron) {
    transform: rotate(180deg);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-2) var(--space-2);
  }
  .toc a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease);
  }
  .toc a:hover {
    background: var(--color-tint);
  }
</style>

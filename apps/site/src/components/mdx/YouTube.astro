---
// Click-to-load YouTube facade: a thumbnail and a play button; the iframe loads on click.
interface Props {
  id: string;
  title?: string;
}
const { id, title = 'YouTube video' } = Astro.props;
---

<div class="embed yt" data-yt={id}>
  <button type="button" class="embed-play" aria-label={`Play: ${title}`} data-title={title}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <svg width="68" height="48" viewBox="0 0 68 48" aria-hidden="true">
      <path
        d="M66.5 7.7a8.6 8.6 0 0 0-6-6C55.2.3 34 .3 34 .3S12.8.3 7.5 1.7a8.6 8.6 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.6 8.6 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.6 8.6 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z"
        fill="#f00"
      ></path>
      <path d="M45 24 27 14v20" fill="#fff"></path>
    </svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1`;
      iframe.title = btn.dataset.title ?? 'YouTube video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 1.5em 0;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .embed :global(iframe),
  .embed-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .embed-play {
    padding: 0;
    cursor: pointer;
    background: #000;
    display: grid;
    place-items: center;
  }
  .embed-play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .embed-play svg {
    position: relative;
  }
</style>

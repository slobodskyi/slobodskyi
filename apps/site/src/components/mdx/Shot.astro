---
// Screenshot / figure. `src` is relative to the record folder ("./file.webp"); the page sets
// Astro.locals.recordDir before rendering the body.
import { Picture, getImage } from 'astro:assets';
import { resolveImage, isOptimizable } from '../../lib/images';

interface Props {
  src: string;
  alt?: string;
  /** Full-width figure (Webflow "fullwidth"). */
  wide?: boolean;
  caption?: string;
}
const { src, alt = '', wide = false, caption } = Astro.props;
const dir = Astro.locals.recordDir;
if (!dir) throw new Error(`<Shot src="${src}"> rendered without Astro.locals.recordDir`);
const image = await resolveImage(dir, src);
const max = Math.min(image.width, 1600);
const widths = [400, 800, 1200, 1600].filter((w) => w < max).concat(max);
const optimizable = isOptimizable(image);
// Large screenshots open at full size (the largest WebP the <picture> already uses: no extra file).
const full =
  optimizable && image.width > 1000
    ? (await getImage({ src: image, width: max, format: 'webp', quality: 72 })).src
    : undefined;
const Wrap = full ? 'a' : 'div';
// Size follows the shape (computed, no per-record flags): landscape images take the text width;
// square-ish and portrait ones would be taller than the screen there, so they are shown smaller,
// centered on a tinted stage. `wide` only makes sense for landscape.
const ratio = image.width / image.height;
const shape = ratio < 0.8 ? 'portrait' : ratio < 1.3 ? 'square' : 'landscape';
const staged = shape !== 'landscape';
const stageWidth = { square: 480, portrait: 360, landscape: 760 };
---

<figure
  class:list={['shot', `shot-${shape}`, { wide: wide && !staged, staged }]}
  style={staged ? `--shot-max:${stageWidth[shape]}px;--shot-ratio:${ratio.toFixed(4)}` : undefined}
>
  {optimizable ? (
    <Wrap href={full} class="shot-link" target={full ? '_blank' : undefined}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif']}
        fallbackFormat="webp"
        quality={72}
        widths={widths}
        sizes={`(max-width: 800px) 100vw, ${Math.min(max, staged ? stageWidth[shape] : wide ? 1080 : 760)}px`}
        loading="lazy"
      />
    </Wrap>
  ) : (
    <div class="shot-link">
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: var(--space-6) 0;
  }
  /* Border + placeholder tint: light screenshots stay distinct from the page while loading too. */
  .shot :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-soft);
    background: var(--color-surface-alt);
  }
  .shot-link {
    display: block;
    border-radius: var(--radius-md);
  }
  .shot-link[href] {
    cursor: zoom-in;
  }
  /* Stage for square-ish and portrait images. The width is derived from the height cap and the
     image's own ratio, so one image fits one screen and space is reserved before it loads. */
  .shot.staged .shot-link {
    padding: var(--space-4);
    background: var(--color-surface-alt);
  }
  .shot.staged .shot-link > :global(*) {
    display: block;
    margin-inline: auto;
    width: min(100%, var(--shot-max), min(70vh, 640px) * var(--shot-ratio));
  }
  .shot.staged :global(img) {
    border-radius: var(--radius-sm);
  }
  .shot.staged :global(picture img) {
    width: 100%;
  }
  .shot figcaption {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: var(--space-2);
    text-align: center;
  }
  @media (min-width: 75rem) {
    .shot.wide {
      margin-left: calc((760px - 1080px) / 2);
      margin-right: calc((760px - 1080px) / 2);
    }
    .shot.wide :global(img) {
      width: 100%;
    }
  }
</style>

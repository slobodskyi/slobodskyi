---
// Highlighted quote of the author (legacy blockquote style with the author avatar).
import { Image } from 'astro:assets';
import author from '../../assets/author.webp';
---

<blockquote class="callout">
  <slot />
  <Image
    src={author}
    alt=""
    width={40}
    height={40}
    densities={[1, 2]}
    loading="lazy"
    class="callout-avatar"
  />
</blockquote>

<style>
  /* Text face, not the wide display face: these quotes run to several lines. */
  .callout {
    background: var(--color-surface);
    border-radius: var(--radius-bubble);
    margin: var(--space-7) 0;
    padding: var(--space-6) var(--space-6) var(--space-5);
    font-size: 1.12em;
    font-weight: 600;
    line-height: 1.5;
    box-shadow: var(--shadow-sm);
  }
  .callout :global(p) {
    margin: 0 0 0.8em;
  }
  .callout :global(strong) {
    background: none;
  }
  .callout-avatar {
    display: block;
    border-radius: 50%;
    margin-top: 12px;
  }
  @media (width < 30rem) {
    .callout {
      padding: var(--space-5);
      font-size: 1.05em;
    }
  }
</style>

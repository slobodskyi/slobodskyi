    'M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z',
} as const;

export type IconName = keyof typeof stroke | keyof typeof fill;

const { name, size = 24, label, class: className } = Astro.props;
const isStroke = name in stroke;
const d = isStroke ? stroke[name as keyof typeof stroke] : fill[name as keyof typeof fill];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {isStroke ? (
    <path
      d={d}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ) : (
    <path d={d} fill="currentColor" />
  )}
</svg>

<style>
  .icon {
    flex: none;
    vertical-align: middle;
  }
</style>

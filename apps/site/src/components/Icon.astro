---
// The one icon set of the site: inline SVG (no requests, inherits currentColor).
// UI icons are 24×24 strokes; brand icons are filled paths.
interface Props {
  name: IconName;
  size?: number;
  /** Accessible name; without it the icon is decorative (aria-hidden). */

---
import Icon from './Icon.astro';
import type { Crumb } from '../lib/schema-org';

interface Props {
  /** First crumb is the home page (rendered as an icon); the current page is not included. */
  crumbs: Crumb[];
  homeLabel: string;
}
const { crumbs, homeLabel } = Astro.props;
const [home, ...rest] = crumbs;
const path = (url: string) => url.replace('https://slobodskyi.com', '') || '/';
---

<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol>
    {home && (
      <li>
        <a href={path(home.url)} aria-label={homeLabel} title={homeLabel}>
          <Icon name="home" size={18} />
        </a>
      </li>
    )}
    {rest.map((c) => (
      <li>
        <a href={path(c.url)}>{c.name}</a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    align-items: center;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .breadcrumbs li + li::before {
    content: '/';
    color: var(--color-border-soft);
  }
  .breadcrumbs a {
    display: flex;
    color: var(--color-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>

---
import type { Lang } from '@slobodskyi/core';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const s = t(Astro.props.lang);
---

<section class="patreon">
  <p>{s.patreonText}</p>
  <a
    class="button"
    href="https://www.patreon.com/slobodskyi?utm_source=slobodskyi-com&utm_medium=after_article&utm_campaign=static"
    target="_blank"
    rel="noopener"
  >
    {s.patreonButton}
  </a>
</section>

<style>
  .patreon {
    background: linear-gradient(135deg, var(--color-tint), var(--color-surface));
    border-radius: var(--radius-bubble);
    padding: var(--space-6);
    margin: var(--space-7) 0;
  }
  .patreon p {
    margin: 0 0 var(--space-5);
  }
  .patreon .button {
    display: block;
    text-align: center;
  }
  @media (width < 30rem) {
    .patreon {
      padding: var(--space-5);
    }
  }
</style>

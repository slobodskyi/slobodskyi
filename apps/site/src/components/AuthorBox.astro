---
// Author card at the end of an article; the default slot holds the share links.
import { Image } from 'astro:assets';
import author from '../assets/author.webp';
import type { Lang } from '@slobodskyi/core';
import { withLangPrefix } from '@slobodskyi/core';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<aside class="author">
  <div class="author-head">
    <Image src={author} alt={s.authorName} width={64} height={64} densities={[1, 2]} loading="lazy" />
    <div>
      <p class="author-label">{s.author}</p>
      <p class="author-name">
        <a href={withLangPrefix(lang, '/about')}>{s.authorName}</a>
      </p>
    </div>
  </div>
  <p class="author-bio">{s.authorBio}</p>
  <slot />
</aside>

<style>
  .author {
    display: grid;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin: var(--space-7) 0 var(--space-6);
  }
  .author-head {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .author img {
    border-radius: 50%;
    flex: none;
  }
  .author :where(p) {
    margin: 0;
  }
  .author-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .author-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 18px;
    line-height: var(--leading-snug);
  }
  .author-name a {
    color: var(--color-text);
    text-decoration: none;
  }
  .author-name a:hover {
    text-decoration: underline;
  }
  .author-bio {
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>

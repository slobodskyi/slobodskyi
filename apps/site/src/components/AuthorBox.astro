---
import { Image } from 'astro:assets';
import author from '../assets/author.webp';
import type { Lang } from '@slobodskyi/core';
import { withLangPrefix } from '@slobodskyi/core';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<aside class="author">
  <Image src={author} alt={s.authorName} width={72} height={72} densities={[1, 2]} loading="lazy" />
  <div>
    <p class="author-label">{s.author}</p>
    <p class="author-name">
      <a href={withLangPrefix(lang, '/about')}>{s.authorName}</a>
    </p>
    <p class="author-bio">{s.authorBio}</p>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--surface);
    border-radius: var(--radius);
    padding: 20px;
    margin: 32px 0;
  }
  .author img {
    border-radius: 50%;
    flex: none;
  }
  .author p {
    margin: 0;
  }
  .author-label {
    font-size: 13px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .author-name {
    font-family: var(--heading);
    font-weight: 600;
    font-size: 18px;
  }
  .author-name a {
    color: var(--text);
  }
  .author-bio {
    font-size: 15px;
    line-height: 1.45;
    margin-top: 4px !important;
  }
</style>

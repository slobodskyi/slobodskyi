---
// Contact form: POST /api/contact (src/worker.ts). Turnstile is rendered when
// PUBLIC_TURNSTILE_SITE_KEY is set at build time. Works without JS (303 back to the page).
import type { Lang } from '@slobodskyi/core';
import { t } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const s = t(Astro.props.lang).form;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<form class="contact-form" method="post" action="/api/contact" data-wait={s.wait}>
  <label for="cf-name">{s.name}</label>
  <input id="cf-name" name="name" type="text" maxlength="256" autocomplete="name" />
  <label for="cf-email">{s.email}</label>
  <input id="cf-email" name="email" type="email" maxlength="256" required autocomplete="email" />
  <label for="cf-message">{s.message}</label>
  <textarea id="cf-message" name="message" maxlength="5000" rows="6" required></textarea>
  <div class="hp" aria-hidden="true">
    <label for="cf-company">Company</label>
    <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="page" value={Astro.url.pathname.replace(/\.html$/, '')} />
  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
  <button type="submit" class="button">
    {s.submit}
  </button>
  <p class="form-status form-success" id="contact-sent" hidden>
    {s.success}
  </p>
  <p class="form-status form-error" id="contact-error" hidden>
    {s.error}
  </p>
</form>
{siteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const show = (id: string) => {
    form?.querySelectorAll<HTMLElement>('.form-status').forEach((el) => (el.hidden = el.id !== id));
  };
  if (location.hash === '#contact-sent' || location.hash === '#contact-error') show(location.hash.slice(1));
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const label = button?.textContent ?? '';
    if (button) {
      button.disabled = true;
      button.textContent = form.dataset.wait ?? '…';
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show('contact-sent');
    } catch {
      show('contact-error');
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = label;
      }
    }
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 24px 0;
  }
  .contact-form label {
    font-weight: 700;
    font-size: 16px;
  }
  .contact-form input,
  .contact-form textarea {
    font: inherit;
    font-size: 17px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 8px;
  }
  .contact-form button {
    align-self: flex-start;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .form-success {
    background: var(--green);
    padding: 12px 16px;
  }
  .form-error {
    background: #ffe1e1;
    padding: 12px 16px;
  }
</style>

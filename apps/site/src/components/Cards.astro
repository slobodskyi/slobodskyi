---
import CardItemView, { type CardItem } from './CardItem.astro';

export type { CardItem };

interface Props {
  items: CardItem[];
  id?: string | undefined;
  /** The first cover is above the fold (home hub list). */
  eager?: boolean;
}
const { items, id, eager = false } = Astro.props;
---

<ul class="cards" id={id}>
  {items.map((item, i) => (
    <CardItemView item={item} eager={eager && i === 0} />
  ))}
</ul>
